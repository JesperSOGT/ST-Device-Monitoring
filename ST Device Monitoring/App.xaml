<Application x:Class="ST_Device_Monitoring.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ST_Device_Monitoring"
             xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="{x:Type prim:DataGridColumnHeader}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#EDF1F5"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Application.Resources>
</Application>

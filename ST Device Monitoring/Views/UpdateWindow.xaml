<Window x:Class="ST_Device_Monitoring.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update" Height="620" Width="720" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/appicon.png">
    <DockPanel Margin="16">

        <Border DockPanel.Dock="Top" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="4"
                Padding="14" Margin="0,0,0,10" Background="#FAFBFC">
            <StackPanel>
                <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="Looking for a new version…"/>
                <TextBlock x:Name="VersionText" Foreground="#444" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="SourceText" Foreground="#666" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="PlanText" TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,6"/>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#C62828" Margin="0,0,0,6"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="CheckButton" Content="Check again" Height="28" MinWidth="100"
                                Padding="10,0" Click="Check_Click"/>
                        <Button x:Name="OpenPageButton" Content="Open release page" Height="28" MinWidth="140"
                                Padding="10,0" Margin="8,0,0,0" Click="OpenPage_Click" IsEnabled="False"
                                ToolTip="Opens the release on github.com in the browser"/>
                        <Button x:Name="SkipButton" Content="Skip this version" Height="28" MinWidth="120"
                                Padding="10,0" Margin="8,0,0,0" Click="Skip_Click" IsEnabled="False"
                                ToolTip="This version is not announced again. A later one still is."/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="InstallButton" Content="Download and install" Height="28" MinWidth="160"
                                Padding="10,0" Margin="8,0,0,0" FontWeight="SemiBold"
                                Click="Install_Click" IsEnabled="False"/>
                        <Button x:Name="CloseButton" Content="Close" Height="28" Width="90" Margin="8,0,0,0"
                                IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="File" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AssetBox" MinWidth="380" Padding="4,3" SelectionChanged="Asset_Changed"
                          IsEnabled="False"
                          ToolTip="Which file to download. The one matching this installation is selected."/>
            </StackPanel>

            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="What is new" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="#FCFCFD" Padding="8"
                         BorderBrush="#DDE3EA"/>
            </DockPanel>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <ProgressBar x:Name="DownloadProgress" Height="18" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                <TextBlock x:Name="ProgressText" Foreground="#456C8C" FontSize="11" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>

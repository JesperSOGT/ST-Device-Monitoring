<Window x:Class="ST_Device_Monitoring.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="700" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#2E7D32"/>
            <Button Content="Cancel" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Width="90" Height="28" IsDefault="True" Click="Save_Click"/>
        </StackPanel>

        <TabControl>
            <!-- Run mode -->
            <TabItem Header="Run mode">
                <StackPanel Margin="14">
                    <TextBlock Text="How should the monitoring run?" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <RadioButton x:Name="ModeNormalBox" GroupName="RunMode" Margin="0,4"
                                 Content="Normal application (this window)"/>
                    <TextBlock Text="Monitoring runs while the program is open. Can be minimised to the system tray."
                               Foreground="#666" FontSize="11" Margin="22,0,0,10" TextWrapping="Wrap"/>

                    <RadioButton x:Name="ModeServiceBox" GroupName="RunMode" Margin="0,4"
                                 Content="Windows service (runs without a logged-in user)"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="22,0,0,10"
                               Text="The service starts with Windows, keeps running after log off and has no user interface - it writes CSV logs, the daily summary and sends e-mail/webhook alerts. Installing, starting and stopping requires administrator rights (a UAC prompt appears). Open this window to see the status and to change the device list; the service reads devices.json when it starts, so restart the service after changing devices."/>

                    <Border BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ServiceStateText" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Install service" Width="120" Height="28" Margin="0,0,8,0" Click="InstallService_Click"/>
                                <Button Content="Start" Width="80" Height="28" Margin="0,0,8,0" Click="StartService_Click"/>
                                <Button Content="Stop" Width="80" Height="28" Margin="0,0,8,0" Click="StopService_Click"/>
                                <Button Content="Remove" Width="90" Height="28" Click="UninstallService_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ServiceHintText" Foreground="#C62828" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Window behaviour" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <CheckBox x:Name="TrayIconBox" Content="Show icon in the system tray" Margin="0,3"/>
                    <CheckBox x:Name="MinimizeToTrayBox" Content="Minimise to the tray instead of the taskbar" Margin="0,3"/>
                    <CheckBox x:Name="CloseToTrayBox" Content="Closing the window keeps monitoring running in the tray" Margin="0,3"/>
                    <CheckBox x:Name="StartMinimizedBox" Content="Start minimised in the tray" Margin="0,3"/>
                    <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows (this user)" Margin="0,3"/>
                    <CheckBox x:Name="AutoStartBox" Content="Start monitoring automatically when the program opens" Margin="0,3"/>
                </StackPanel>
            </TabItem>

            <!-- Notifications -->
            <TabItem Header="Notifications">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="On screen" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CheckBox x:Name="BalloonBox" Content="Show a notification when a device goes down or recovers" Margin="0,3"/>
                        <CheckBox x:Name="SoundBox" Content="Play a sound when a device goes down" Margin="0,3"/>
                        <DockPanel Margin="22,4,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse…" Width="80" Margin="6,0,0,0" Click="BrowseSound_Click"/>
                            <TextBox x:Name="SoundFileBox" Padding="4,3" ToolTip="Optional .wav file - empty means the standard Windows sound"/>
                        </DockPanel>
                        <CheckBox x:Name="NotifyRecoveryBox" Content="Also notify when a device comes back" Margin="0,3"/>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Minimum seconds between notifications for the same device" VerticalAlignment="Center"/>
                            <TextBox x:Name="ThrottleBox" Width="60" Margin="8,0,0,0" Padding="4,3" HorizontalAlignment="Left"/>
                        </DockPanel>

                        <TextBlock Text="E-mail" FontWeight="SemiBold" Margin="0,18,0,6"/>
                        <CheckBox x:Name="EmailBox" Content="Send e-mail on state changes" Margin="0,3"/>
                        <Grid Margin="22,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="SMTP server" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="Port" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                <TextBox DockPanel.Dock="Right" x:Name="SmtpPortBox" Width="60" Padding="4,3"/>
                                <TextBox x:Name="SmtpHostBox" Padding="4,3"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="User" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SmtpUserBox" Padding="4,3" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="SmtpPasswordBox" Padding="4,3" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Text="From" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="MailFromBox" Padding="4,3" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="4" Text="To" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="MailToBox" Padding="4,3" Margin="0,0,0,6"
                                     ToolTip="Several recipients separated by ; or ,"/>
                            <CheckBox Grid.Row="5" Grid.Column="1" x:Name="SmtpSslBox" Content="Use SSL/TLS" Margin="0,2,0,0"/>
                        </Grid>

                        <TextBlock Text="Webhook" FontWeight="SemiBold" Margin="0,18,0,6"/>
                        <CheckBox x:Name="WebhookBox" Content="POST a JSON message on state changes (Teams, Slack, ticket system …)" Margin="0,3"/>
                        <TextBox x:Name="WebhookUrlBox" Padding="4,3" Margin="22,6,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Send test notification" Padding="12,4" Click="TestAlert_Click"/>
                            <TextBlock x:Name="TestResultText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,14,0,0"
                                   Text="The SMTP password is stored encrypted with the Windows DPAPI for the current user. If you run the monitoring as a Windows service under another account, the service cannot read it - use an account without a password requirement (anonymous relay) or run the service as the same user."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Logging -->
            <TabItem Header="Logging">
                <StackPanel Margin="14">
                    <TextBlock Text="Log folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Width="80" Margin="6,0,0,0" Click="BrowseLogFolder_Click"/>
                        <TextBox x:Name="LogDirBox" Padding="4,3"/>
                    </DockPanel>
                    <TextBlock Text="A relative path is resolved against the program folder. Changing this takes effect on restart."
                               Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <DockPanel Margin="0,14,0,0">
                        <TextBlock Text="Delete log files older than (days, 0 = never)" VerticalAlignment="Center"/>
                        <TextBox x:Name="RetentionBox" Width="60" Margin="8,0,0,0" Padding="4,3" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="UI refresh interval (ms)" VerticalAlignment="Center"/>
                        <TextBox x:Name="UiRefreshBox" Width="60" Margin="8,0,0,0" Padding="4,3" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <TextBlock Text="What is logged" FontWeight="SemiBold" Margin="0,18,0,6"/>
                    <CheckBox x:Name="LogAllBox" Content="Log every check including response time" Margin="0,0,0,2"/>
                    <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,4"
                               Text="On: every successful check is written to ping_yyyyMMdd.csv with its response time. That is the full history - and about 36,000 lines per hour per device at a 100 ms interval."/>
                    <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,4"
                               Text="Off: only failures, the suppression notice, recoveries and group pauses are logged - plus the first successful check of each device (marked 'First successful check'), so you can always see when it was first seen online. The 'first' check counts again after the monitoring is restarted or the counters are reset."/>
                    <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,10"
                               Text="The setting only affects the log files. Counters, the history graph, alarms and the daily report (uptime %) are identical either way, and errors_yyyyMMdd.csv always contains failures only."/>
                    <CheckBox x:Name="DailySummaryBox" Content="Write summary_yyyyMMdd.csv automatically at midnight" Margin="0,3"/>

                    <TextBlock Text="Size limit per log file" FontWeight="SemiBold" Margin="0,18,0,6"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Maximum size (MB, 0 = no limit)" VerticalAlignment="Center"/>
                        <TextBox x:Name="MaxSizeBox" Width="70" Margin="8,0,0,0" Padding="4,3" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <RadioButton x:Name="RotationNoneBox" GroupName="Rotation" Margin="0,3"
                                 Content="No limit - one file per day"/>
                    <RadioButton x:Name="RotationZipBox" GroupName="Rotation" Margin="0,3"
                                 Content="Start a new file and compress the old one to .zip"/>
                    <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,6"
                               Text="The full file is renamed with a timestamp (ping_20260818_143012.csv), zipped in the background and the .csv is deleted. Logging continues in a fresh file without losing an entry."/>
                    <RadioButton x:Name="RotationRingBox" GroupName="Rotation" Margin="0,3"
                                 Content="Ring buffer - keep the same file and drop the oldest lines"/>
                    <DockPanel Margin="22,4,0,0">
                        <TextBlock Text="Drop this much of the oldest content each time (%)" VerticalAlignment="Center"/>
                        <TextBox x:Name="RingTrimBox" Width="60" Margin="8,0,0,0" Padding="4,3" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,0"
                               Text="The file keeps its name and always holds the newest entries; a TRIMMED line marks where older entries were removed. Nothing is archived - use zip mode if the history must be kept."/>
                </StackPanel>
            </TabItem>

            <!-- Updates -->
            <TabItem Header="Updates">
                <StackPanel Margin="14">
                    <TextBlock Text="New versions from GitHub" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,10"
                               Text="The program can look at the releases published on GitHub and install a newer exe over itself. Only the release list is read - nothing about this machine is sent, and nothing is installed without you pressing the button."/>

                    <CheckBox x:Name="UpdateCheckStartupBox" Content="Look for a new version when the program starts" Margin="0,3"/>
                    <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8"
                               Text="One request to github.com a few seconds after start. If a newer release exists, a yellow note appears in the status bar - monitoring is never interrupted by itself."/>

                    <CheckBox x:Name="UpdatePreReleaseBox" Content="Also offer versions marked as pre-release" Margin="0,3"/>
                    <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,10"
                               Text="Off means only finished releases are offered."/>

                    <TextBlock Text="Repository" FontWeight="SemiBold" Margin="0,10,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Owner" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="UpdateOwnerBox" Padding="4,3" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="Repository" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="UpdateRepoBox" Padding="4,3" Margin="0,0,0,6"/>
                    </Grid>
                    <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="The repository has to be public for the download to work without a GitHub account."/>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Check for updates now" Padding="12,4" Click="CheckUpdate_Click"/>
                        <Button Content="Clear skipped version" Padding="12,4" Margin="8,0,0,0" Click="ClearSkip_Click"
                                ToolTip="Announce a version again that you chose to skip"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,14,0,0"
                               Text="How the swap works: the new exe is downloaded to the temporary folder and its size and checksum are verified. A small script then replaces the program file as soon as the program closes, and starts it again. The version that was replaced is kept next to the program as 'ST Device Monitoring.exe.previous', so it can be put back by hand. If the Windows service is installed it is stopped and started again, which needs administrator rights."/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

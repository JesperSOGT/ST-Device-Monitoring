<Window x:Class="ST_Device_Monitoring.Views.DhcpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Give a device an address (DHCP)" Height="620" Width="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/appicon.png">
    <DockPanel Margin="16">

        <Border DockPanel.Dock="Top" BorderBrush="#E6A23C" BorderThickness="1" CornerRadius="4"
                Background="#FFF8E8" Padding="12" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" Foreground="#7A5200"
                       Text="This hands out an IP address to a device that only asks by DHCP - for a device connected directly to this machine. The server listens on the one adapter you choose and, unless you clear the MAC lock, answers only that one device. Never run it on a company network without the MAC lock: another DHCP server on the wire disturbs everyone."/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#666"/>
                <Button x:Name="StartButton" Content="Start server" Width="110" Height="28" Margin="0,0,8,0" Click="Start_Click"/>
                <Button x:Name="StopButton" Content="Stop" Width="80" Height="28" Margin="0,0,8,0" Click="Stop_Click" IsEnabled="False"/>
                <Button Content="Close" Width="90" Height="28" IsCancel="True"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Network adapter" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="AdapterBox" Margin="0,0,0,8" Padding="4,3"
                               SelectionChanged="Adapter_Changed"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="This machine gets" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Apply to adapter" Width="130" Margin="6,0,0,0"
                                Click="ApplyAdapterIp_Click"
                                ToolTip="Sets this address on the adapter with netsh (needs administrator rights)"/>
                        <TextBox x:Name="ServerIpBox" Padding="4,3"/>
                    </DockPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Device gets" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="OfferIpBox" Margin="0,0,0,8" Padding="4,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Subnet mask" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="MaskBox" Text="255.255.255.0" Margin="0,0,0,8" Padding="4,3"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Gateway (optional)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="GatewayBox" Margin="0,0,0,8" Padding="4,3"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="DNS (optional)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" x:Name="DnsBox" Margin="0,0,0,8" Padding="4,3"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Only answer this MAC" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="Lease (min)" VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <TextBox DockPanel.Dock="Right" x:Name="LeaseBox" Width="60" Text="60" Padding="4,3"/>
                        <TextBox x:Name="MacBox" Padding="4,3" ToolTip="Empty = answer any device (only do that on an isolated cable)"/>
                    </DockPanel>

                    <CheckBox Grid.Row="7" Grid.Column="1" x:Name="AddDeviceBox" IsChecked="True" Margin="0,2,0,0"
                              Content="Add the device to the monitoring list when it accepts the address"/>
                </Grid>

                <TextBlock Text="Log" FontWeight="SemiBold" Margin="0,14,0,4"/>
            </StackPanel>

            <ListBox Grid.Row="1" x:Name="LogList" FontFamily="Consolas" FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</Window>

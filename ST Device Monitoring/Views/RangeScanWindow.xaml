<Window x:Class="ST_Device_Monitoring.Views.RangeScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan IP range" Height="640" Width="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">

        <!-- Range and defaults -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="From IP" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="FromBox" Padding="4,3" Margin="0,0,16,6"
                           TextChanged="Range_Changed"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="To IP" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="ToBox" Padding="4,3" Margin="0,0,0,6"
                           TextChanged="Range_Changed"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Check" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,6">
                    <RadioButton x:Name="IcmpBox" Content="ICMP" GroupName="Mode" IsChecked="True" VerticalAlignment="Center"
                                 Checked="Mode_Changed"/>
                    <RadioButton x:Name="TcpBox" Content="TCP" GroupName="Mode" VerticalAlignment="Center" Margin="12,0,0,0"
                                 Checked="Mode_Changed"/>
                    <RadioButton x:Name="SnmpBox" Content="SNMP" GroupName="Mode" VerticalAlignment="Center" Margin="12,0,6,0"
                                 Checked="Mode_Changed"/>
                    <TextBox x:Name="PortBox" Width="55" Padding="4,3" Text="502"/>
                    <TextBlock Text="Community" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11" Foreground="#666"/>
                    <TextBox x:Name="CommunityBox" Width="80" Padding="4,3" Text="public" IsEnabled="False"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Timeout (ms)" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox   Grid.Row="1" Grid.Column="3" x:Name="TimeoutBox" Padding="4,3" Text="500" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Name prefix" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PrefixBox" Padding="4,3" Margin="0,0,16,6"
                           ToolTip="Devices are named &quot;prefix 192.168.1.50&quot; unless a DNS name is found"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Group" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox   Grid.Row="2" Grid.Column="3" x:Name="GroupBox" Padding="4,3" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Interval (ms)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="IntervalBox" Padding="4,3" Text="1000" Margin="0,0,16,0"/>
                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                    <CheckBox x:Name="ResolveNamesBox" Content="Look up DNS names" IsChecked="True" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.ColumnSpan="4" x:Name="RangeHint"
                           FontSize="11" TextWrapping="Wrap" Foreground="#666" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#666"/>
            <Button Content="Select all" Width="90" Height="28" Margin="0,0,8,0" Click="SelectAll_Click"/>
            <Button Content="Select none" Width="90" Height="28" Margin="0,0,8,0" Click="SelectNone_Click"/>
            <Button Content="Cancel" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="AddButton" Content="Add selected" Width="120" Height="28" Click="Add_Click" IsEnabled="False"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ScanButton" Content="Scan" Width="110" Height="28" Click="Scan_Click"/>
            <Button x:Name="StopScanButton" Content="Stop" Width="80" Height="28" Margin="8,0,0,0" Click="StopScan_Click" IsEnabled="False"/>
            <ProgressBar x:Name="ScanProgress" Width="260" Height="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="OnlyRespondingBox" Content="Show only devices that answered" IsChecked="True"
                      VerticalAlignment="Center" Margin="12,0,0,0" Checked="OnlyResponding_Changed" Unchecked="OnlyResponding_Changed"/>
        </StackPanel>

        <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" ColumnWidth="Auto">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Add" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="45"/>
                <DataGridTextColumn Header="IP address" Binding="{Binding Address}" IsReadOnly="True" Width="Auto" MinWidth="120"/>
                <DataGridTextColumn Header="Answered" Binding="{Binding RespondedText}" IsReadOnly="True" Width="Auto" MinWidth="80"/>
                <DataGridTextColumn Header="Response" Binding="{Binding ResponseText}" IsReadOnly="True" Width="Auto" MinWidth="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="Auto" MinWidth="110"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="160"/>
                <DataGridTextColumn Header="Description (SNMP)" Binding="{Binding Description}" IsReadOnly="True" Width="*" MinWidth="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

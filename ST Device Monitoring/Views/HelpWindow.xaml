<Window x:Class="ST_Device_Monitoring.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help - ST Device Monitoring" Height="640" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/appicon.png">
    <DockPanel Margin="0">
        <Border DockPanel.Dock="Top" Background="#F5F7FA" BorderBrush="#DDE3EA" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel>
                <TextBlock Text="ST Device Monitoring - help" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="#666" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,10" Background="#FAFBFC" BorderBrush="#DDE3EA" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Width="90" Height="28" IsCancel="True" IsDefault="True"/>
                <TextBlock Text="Press F1 in the main window to open this help." Foreground="#666"
                           FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="TopicList" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#DDE3EA"
                     SelectionChanged="Topic_Changed">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <TextBlock x:Name="TopicTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TopicBody" TextWrapping="Wrap" LineHeight="20" FontSize="12.5"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
